[
  {
    "schemaVersion": 1,
    "id": "ambiguous-duplicate-results",
    "category": "ambiguous",
    "title": "Every result card duplicated",
    "rationale": "Each card appears twice, identically; both copies lead to the same offer, so either is correct.",
    "workflow": {
      "id": "open-offer",
      "gestures": [
        {
          "goto": "/results.html?q=data&ville="
        },
        {
          "click": {
            "role": "link",
            "name": "Data engineer junior"
          }
        },
        {
          "waitForUrl": "offer\\.html"
        }
      ]
    },
    "mutations": [
      "duplicate-results"
    ],
    "permissions": [],
    "expected": {
      "outcome": "complete",
      "target": "Data engineer junior",
      "human": "optional",
      "success": [
        {
          "type": "url",
          "pattern": "offer\\.html\\?id=data-paris"
        }
      ]
    },
    "forbidden": [
      {
        "type": "url",
        "pattern": "^https?://(?!localhost:5173)"
      }
    ]
  },
