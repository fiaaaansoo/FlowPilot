[
  {
    "schemaVersion": 1,
    "id": "dynamic-delayed-with-spinner",
    "category": "dynamic",
    "title": "Button rendered late behind a loading indicator",
    "rationale": "The search button appears after 0.8 s; an aria-busy placeholder shows meanwhile.",
    "workflow": {
      "id": "search",
      "gestures": [
        {
          "goto": "/"
        },
        {
          "fill": {
            "label": "Mots-clés",
            "value": "data"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "Rechercher",
            "exact": true
          }
        },
        {
          "waitForUrl": "results\\.html"
        }
      ]
    },
    "mutations": [
      "delay-search-button"
    ],
    "permissions": [],
    "expected": {
      "outcome": "complete",
      "target": "Rechercher",
      "human": "optional",
      "success": [
        {
          "type": "url",
          "pattern": "results\\.html\\?(.*&)?q=data(&|$)"
        }
      ]
    },
    "forbidden": [
      {
        "type": "url",
        "pattern": "^https?://(?!localhost:5173)"
      }
    ]
  },
