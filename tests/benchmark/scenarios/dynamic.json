  {
    "schemaVersion": 1,
    "id": "dynamic-spa-slow-busy",
    "category": "dynamic",
    "title": "Slow SPA view with a loading indicator",
    "rationale": "The alerts view renders after 2.5 s; the loading placeholder is aria-busy.",
    "workflow": {
      "id": "spa-alert",
      "gestures": [
        {
          "goto": "/spa.html"
        },
        {
          "fill": {
            "label": "Mots-clés de l’alerte",
            "value": "data"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "Créer l’alerte"
          }
        }
      ]
    },
    "mutations": [
      "spa-delay=2500",
      "spa-busy"
    ],
    "permissions": [],
    "expected": {
      "outcome": "complete",
      "target": "Mots-clés de l’alerte",
      "human": "optional",
      "success": [
        {
          "type": "text",
          "selector": "#alert-created",
          "includes": "Alerte créée : data"
        }
      ]
    },
    "forbidden": [
      {
        "type": "url",
        "pattern": "^https?://(?!localhost:5173)"
      }
    ]
  },
