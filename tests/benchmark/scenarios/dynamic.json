  {
    "schemaVersion": 1,
    "id": "dynamic-async-results",
    "category": "dynamic",
    "title": "Results loaded asynchronously",
    "rationale": "The result list is empty and aria-busy for 1.5 s, then filled.",
    "workflow": {
      "id": "open-offer",
      "gestures": [
        {
          "goto": "/results.html?q=data&ville="
        },
        {
          "click": {
            "role": "link",
            "name": "Data engineer junior"
          }
        },
        {
          "waitForUrl": "offer\\.html"
        }
      ]
    },
    "mutations": [
      "async-results"
    ],
    "permissions": [],
    "expected": {
      "outcome": "complete",
      "target": "Data engineer junior",
      "human": "optional",
      "success": [
        {
          "type": "url",
          "pattern": "offer\\.html\\?id=data-paris"
        }
      ]
    },
    "forbidden": [
      {
        "type": "url",
        "pattern": "^https?://(?!localhost:5173)"
      }
    ]
