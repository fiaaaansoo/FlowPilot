[
  {
    "schemaVersion": 1,
    "id": "semantic-reworded",
    "category": "semantic",
    "title": "Search button reworded",
    "rationale": "« Rechercher » becomes « Lancer la recherche »: same word stem, same control.",
    "workflow": {
      "id": "search",
      "gestures": [
        {
          "goto": "/"
        },
        {
          "fill": {
            "label": "Mots-clés",
            "value": "data"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "Rechercher",
            "exact": true
          }
        },
        {
          "waitForUrl": "results\\.html"
        }
      ]
    },
    "mutations": [
      "search-label=reworded"
    ],
    "permissions": [],
    "expected": {
      "outcome": "complete",
      "target": "Lancer la recherche",
      "human": "optional",
      "success": [
        {
          "type": "url",
          "pattern": "results\\.html\\?(.*&)?q=data(&|$)"
        }
      ]
    },
    "forbidden": [
      {
        "type": "url",
        "pattern": "^https?://(?!localhost:5173)"
      }
    ]
  },
