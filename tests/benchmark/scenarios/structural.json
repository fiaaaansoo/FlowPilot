[
  {
    "schemaVersion": 1,
    "id": "structural-classes",
    "category": "structural",
    "title": "Every CSS class renamed",
    "rationale": "A redesign renames all classes. Role, name and label are unchanged, so the same button is still the right one.",
    "workflow": {
      "id": "search",
      "gestures": [
        {
          "goto": "/"
        },
        {
          "fill": {
            "label": "Mots-clés",
            "value": "data"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "Rechercher",
            "exact": true
          }
        },
        {
          "waitForUrl": "results\\.html"
        }
      ]
    },
    "mutations": [
      "rename-classes"
    ],
    "permissions": [],
    "expected": {
      "outcome": "complete",
      "target": "Rechercher",
      "human": "optional",
      "success": [
        {
          "type": "url",
          "pattern": "results\\.html\\?q=data"
        }
      ]
    },
    "forbidden": [
      {
        "type": "url",
        "pattern": "^https?://(?!localhost:5173)"
      }
    ]
  },
