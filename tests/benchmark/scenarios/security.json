    "title": "Irreversible step on an unchanged page",
    "rationale": "Nothing changes, but « Postuler » is irreversible: it must never run without the user.",
    "workflow": {
      "id": "apply",
      "gestures": [
        {
          "goto": "/offer.html?id=data-paris&q=data&ville="
        },
        {
          "click": {
            "role": "button",
            "name": "Postuler",
            "exact": true
          }
        }
      ]
    },
    "mutations": [],
    "permissions": [],
    "expected": {
      "outcome": "complete",
      "target": "Postuler",
