# FlowPilot recovery backend configuration. Copy to `.env` (git-ignored) and adjust.
# Generate the token with: python -m flowpilot_api token
# Paste the same token in the side panel (AI recovery settings).
FLOWPILOT_API_TOKEN=

# Listen on loopback only. Non-loopback addresses need FLOWPILOT_ALLOW_REMOTE=1 (not recommended).
FLOWPILOT_HOST=127.0.0.1
FLOWPILOT_PORT=8787

# Origin of the installed extension, e.g. chrome-extension://<extension id> (comma-separated list).
FLOWPILOT_ALLOWED_ORIGINS=

# Model provider: none | ollama | openai-compatible | anthropic | mock
#   none               deterministic + semantic recovery only (default, no model, no cost)
#   ollama             local open-weight model, e.g. FLOWPILOT_MODEL=qwen2.5:3b (free, offline)
#   openai-compatible  llama.cpp `llama-server`, vLLM, LM Studio... (local by default)
#   anthropic          Claude API, billed per token; needs ANTHROPIC_API_KEY from the Claude Console
#   mock               deterministic test double (FLOWPILOT_MOCK_RULES)
FLOWPILOT_PROVIDER=none
FLOWPILOT_MODEL=

# Ollama
FLOWPILOT_OLLAMA_URL=http://127.0.0.1:11434
FLOWPILOT_OLLAMA_NUM_CTX=4096

# OpenAI-compatible endpoint (llama.cpp: http://127.0.0.1:8080/v1, vLLM: http://127.0.0.1:8000/v1, LM Studio: http://127.0.0.1:1234/v1)
FLOWPILOT_OPENAI_BASE_URL=
FLOWPILOT_OPENAI_API_KEY=
# Set to 1 only when the endpoint bills per token; then also set the prices below.
FLOWPILOT_OPENAI_IS_PAID=0

# Claude API (optional, paid). The key is read by the official SDK from the environment.
# ANTHROPIC_API_KEY=
FLOWPILOT_ANTHROPIC_EFFORT=medium

# Price overrides in USD per million tokens (paid providers only).
FLOWPILOT_PRICE_INPUT_PER_MTOK=
FLOWPILOT_PRICE_OUTPUT_PER_MTOK=

# Model call behaviour
FLOWPILOT_LLM_TIMEOUT_S=30
FLOWPILOT_LLM_MAX_RETRIES=1

# Context window bounds (context-rot control)
FLOWPILOT_CONTEXT_MAX_ELEMENTS=12
FLOWPILOT_CONTEXT_MAX_CHARS=6000

# Memory and telemetry database
FLOWPILOT_DB_PATH=.data/flowpilot.sqlite3

# Mock provider rules: "<recorded label>=><label to propose>;..."
FLOWPILOT_MOCK_RULES=
