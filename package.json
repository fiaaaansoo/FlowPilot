{
  "name": "flowpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Extension Chrome open source qui enregistre une procédure web puis la rejoue, avec un moteur de récupération agentique (phases ultérieures).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15"
  },
  "workspaces": [
    "packages/*",
    "apps/extension",
    "apps/demo-site"
  ],
  "scripts": {
    "dev:demo": "npm run dev -w @flowpilot/demo-site",
    "dev:extension": "npm run dev -w @flowpilot/extension",
    "build": "npm run build -w @flowpilot/extension && npm run build -w @flowpilot/demo-site",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build -w @flowpilot/extension && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "bench": "npm run build -w @flowpilot/extension && playwright test -c playwright.benchmark.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
